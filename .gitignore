# ==========================================
# ML Model Artifacts & Heavy Weights
# ==========================================
# Ignore raw/intermediate model binaries & weights
*.joblib
*.pkl
*.pickle
*.h5
*.hdf5
*.pth
*.pt
*.onnx
*.pb
*.tflite
*.ckpt
*.bin
*.model
*.safetensors

# Preserve production model pipeline weight
!Ml_Service/models/production/insurewise_model.joblib
!models/production/insurewise_model.joblib

# ==========================================
# ML Experiment Tracking & Logs
# ==========================================
wandb/
mlruns/
tensorboard/
logs/
**/logs/
*.log

