.ipynb_checkpoints
**/.ipynb_checkpoints
*-checkpoint.ipynb

# ==========================================
# Testing & Code Quality
# ==========================================
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage/
htmlcov/
nosetests.xml
coverage.xml
*.cover
