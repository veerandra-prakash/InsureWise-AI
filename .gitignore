# ==========================================
# InsureWise AI System - Global GitIgnore
# ==========================================

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.pfx
*.crt
*.p12
secrets.json
credentials.json

# ==========================================
# Node.js & Frontend Build Artifacts
# ==========================================
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
build/
**/build/
.cache/
.parcel-cache/
.next/
.nuxt/
.out/
.oxlintrc.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Python & Bytecode Caches
# ==========================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Virtual Environments
