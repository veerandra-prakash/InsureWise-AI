!.env.*.example
*.pem
*.key
secrets.json

# Node.js Dependencies & Build Artifacts
node_modules/
dist/
build/
.cache/
jspm_packages/
.npm
.node_repl_history

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/
.junit/

# IDE & System Files
.vscode/
.idea/
.gemini/
.DS_Store
Thumbs.db
*.swp
*.swo
