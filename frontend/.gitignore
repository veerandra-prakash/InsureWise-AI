logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & System Files
.vscode/
.idea/
.gemini/
.DS_Store
Thumbs.db
*.swp
*.swo
