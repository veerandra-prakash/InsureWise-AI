# ==========================================
# ML Service - GitIgnore
# ==========================================

# Environment Variables & Secrets
.env
.env.local
.env.*.local
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets.json

# Python & Bytecode Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/

# Testing & Code Quality
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ML Model Binary Artifacts
# Ignore intermediate/experimental model binaries
*.joblib
*.pkl
*.pickle
*.h5
*.hdf5
*.pth
*.pt
*.onnx
*.bin
*.model

# Keep required production pipeline model
!models/production/insurewise_model.joblib

# Logs & Experiment Tracking
*.log
logs/
wandb/
mlruns/
tensorboard/

# IDE & OS Files
.vscode/
.idea/
.gemini/
.DS_Store
Thumbs.db
*.swp
*.swo
